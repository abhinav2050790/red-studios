# Red Studios Environment Variables
# Copy this file to .env.local for local development

# Resend API Key for sending project brief emails (Optional during local testing, required in production)
# Sign up at https://resend.com to generate your API key
RESEND_API_KEY=re_your_api_key_here

# Recipient email where client brief submissions should be delivered
STUDIO_RECIPIENT_EMAIL=hello@redstudios.com

# Base URL for metadata and OpenGraph images
NEXT_PUBLIC_SITE_URL=https://redstudios.com
